# 결제 모드. 기본은 mock(전송 없음). 실제 전송은 두 줄이 모두 있어야 시작된다.
AEGIS_PAYMENT_MODE=mock
AEGIS_REAL_PAYMENT_APPROVED=no

# Base Sepolia에 이미 배포된 AEGIS 토큰 (ERC-20, 소수점 6자리)
AEGIS_TOKEN_ADDRESS=0x3440294d5fdc4849461c6f383a7fcf89af0c4a4b
AEGIS_CHAIN_ID=84532
AEGIS_RPC_URL=https://sepolia.base.org

# 구매자 지갑의 개인키. 값은 여기에 적지 말고 .env.local 에만 넣는다.
AEGIS_BUYER_PRIVATE_KEY=

# 한 번에 보낼 수 있는 상한(토큰 최소 단위). 계산 실수로 큰 금액이 나가는 것을 막는다.
AEGIS_MAX_TRANSACTION_UNITS=100000
